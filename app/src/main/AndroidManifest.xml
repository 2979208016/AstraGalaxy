<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 仅用于「打开 GitHub 项目主页」这类显式跳转；模块本体不联网 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 向星河岛投送内容项。权限由星流（宿主）定义，普通级别，不弹授权框。
         新版岛校验的是 com.astraflow.tool.island.* 这组名（岛侧对 source 包名
         逐个 checkPermission），三个名字都声明上，正式包 / 调试包 / 旧版都覆盖。 -->
    <uses-permission android:name="com.astraisland.permission.PUBLISH_ACTIVITY" />
    <uses-permission android:name="com.astraflow.tool.island.permission.PUBLISH_ACTIVITY" />
    <uses-permission android:name="com.astraflow.tool.debug.island.permission.PUBLISH_ACTIVITY" />

    <queries>
        <package android:name="org.lsposed.manager" />
        <!-- 星河岛宿主（星流正式 / 调试包） -->
        <package android:name="com.astraflow.tool" />
        <package android:name="com.astraflow.tool.debug" />
        <!-- 设置页要列出可用的浏览器，需要能看见处理 http 的应用 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:name=".app.XingHeApp"
        android:allowBackup="true"
        android:description="@string/xposed_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LyricProvider">

        <!-- 设置页 -->
        <activity
            android:name=".ui.page.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LyricProvider">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>

        <!-- 桌面入口 alias -->
        <activity-alias
            android:name=".ui.LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".ui.page.HomeActivity"
            android:theme="@style/Theme.LyricProvider">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 首页 -->
        <activity
            android:name=".ui.page.HomeActivity"
            android:exported="true"
            android:label="@string/app_name_launcher"
            android:theme="@style/Theme.LyricProvider" />

        <!-- 能力详情页 -->
        <activity
            android:name=".ui.page.LyricDetailActivity"
            android:exported="false"
            android:label="@string/cap_lyric"
            android:parentActivityName=".ui.page.HomeActivity"
            android:theme="@style/Theme.LyricProvider.Detail" />
        <activity
            android:name=".ui.page.LinkDetailActivity"
            android:exported="false"
            android:label="@string/cap_link"
            android:parentActivityName=".ui.page.HomeActivity"
            android:theme="@style/Theme.LyricProvider.Detail" />

        <!-- 打开链接的中转页（透明、瞬间 finish，不向外部开放） -->
        <activity
            android:name=".capability.link.LinkOpenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.LyricProvider.Transparent" />

        <!-- 底部抽屉 -->
        <activity
            android:name=".ui.page.SheetActivity"
            android:exported="false"
            android:theme="@style/Theme.LyricProvider.Sheet"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!-- 链接投递入口（ContentProvider，Binder 直连，不受广播管控影响） -->
        <provider
            android:name=".app.LinkInboxProvider"
            android:authorities="io.github.proify.lyricon.xinghe.inbox"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- ============ LyricON 提供端识别 ============ -->
        <meta-data
            android:name="lyricon_module"
            android:value="true" />
        <meta-data
            android:name="lyricon_module_author"
            android:value="@string/lyricon_module_author" />
        <meta-data
            android:name="lyricon_module_description"
            android:value="@string/lyricon_module_description" />
        <meta-data
            android:name="lyricon_module_tags"
            android:resource="@array/lyricon_module_tags" />

        <!-- ============ LSPosed 声明 ============ -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="102" />
        <!-- 链接助手只需勾「系统框架」（system），歌词胶囊勾播放器进程 -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
        <meta-data
            android:name="xposedsharedprefs"
            android:value="true" />

    </application>

</manifest>
